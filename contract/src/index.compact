// Midnight Compact 0.19 Smart Contract: AegisVault
// Confidential Real-World Asset (RWA) Collateralization & Selective Compliance Lending
// Platform: Midnight Network (Compact Language v0.19)

pragma language_version >= 0.19.0;

import CompactStandardLibrary;

export enum VaultAssetType {
    USTreasuryBills,       // Tier-1 Sovereign Debt
    CorporateBonds,        // High-Yield Institutional Credit
    CommercialRealEstate,  // Verified Property Equity
    PrivateCredit          // Syndicated Institutional Loan
}

export enum LoanStatus {
    Active,
    Repaid,
    Liquidated
}

export struct ShieldedCollateralCommitment {
    commitmentHash: Bytes[32],
    timestamp: Uint<64>,
    minRatioBps: Uint<16> // 15000 = 150%
}

export struct LoanAgreement {
    loanId: Bytes[32],
    principalAmount: Uint<64>,
    interestRateBps: Uint<16>,
    accreditedRoot: Bytes[32],
    nullifier: Bytes[32],
    status: LoanStatus,
    createdAt: Uint<64>
}

export struct AuditorDisclosureRecord {
    auditorKeyCommitment: Bytes[32],
    encryptedViewingKey: Bytes[64],
    timestamp: Uint<64>
}

// -------------------------------------------------------------------------
// Public Ledger State (Visible on the Midnight Blockchain)
// -------------------------------------------------------------------------
export ledger collateralCommitments: Map<Bytes[32], ShieldedCollateralCommitment>;
export ledger activeLoans: Map<Bytes[32], LoanAgreement>;
export ledger spentNullifiers: Set<Bytes[32]>; // Enforces 1 loan per collateral secret without revealing identity
export ledger auditorDisclosures: Map<Bytes[32], AuditorDisclosureRecord>; // Selective regulatory access
export ledger totalProtocolBorrowed: Uint<64>;
export ledger totalCollateralCommitmentsCount: Uint<64>;

// -------------------------------------------------------------------------
// Private Witness Declarations (Shielded Client-Side Prover Inputs)
// -------------------------------------------------------------------------
witness getBorrowerSecret(): Bytes[32];
witness getCollateralValueUSD(): Uint<64>;
witness getAssetType(): Uint<8>;
witness getCollateralSalt(): Bytes[32];
witness getAccreditedMerkleProof(): Vector<Bytes[32], 16>;
witness getAuditorViewingKey(): Bytes[64];

// -------------------------------------------------------------------------
// Cryptographic Circuit Helpers
// -------------------------------------------------------------------------

// Circuit helper: Computes Collateral Commitment = Hash(secret, valueUSD, assetType, salt)
circuit computeCollateralCommitment(
    secret: Bytes[32],
    valueUSD: Uint<64>,
    assetType: Uint<8>,
    salt: Bytes[32]
): Bytes[32] {
    return persistent_hash<Vector<Bytes[32], 4>>([
        secret,
        salt,
        persistent_hash<Uint<64>>(valueUSD),
        persistent_hash<Uint<8>>(assetType)
    ]);
}

// Circuit helper: Computes Borrow Nullifier = Hash(secret, loanId)
circuit computeBorrowNullifier(secret: Bytes[32], loanId: Bytes[32]): Bytes[32] {
    return persistent_hash<Vector<Bytes[32], 2>>([secret, loanId]);
}

// Circuit helper: Computes Investor Identity Commitment = Hash(secret)
circuit computeInvestorCommitment(secret: Bytes[32]): Bytes[32] {
    return persistent_hash<Bytes[32]>(secret);
}

// -------------------------------------------------------------------------
// Exported State Transitions & Circuit Proofs
// -------------------------------------------------------------------------

// 1. Lock Shielded Collateral Commitment
export circuit depositShieldedCollateral(
    commitmentHash: Bytes[32],
    minRatioBps: Uint<16>,
    timestamp: Uint<64>
): [] {
    assert !collateralCommitments.member(commitmentHash) "Collateral commitment already registered";
    assert minRatioBps >= 12000 "Minimum collateral ratio must be at least 120% (12000 bps)";

    collateralCommitments.insert(commitmentHash, ShieldedCollateralCommitment {
        commitmentHash: commitmentHash,
        timestamp: timestamp,
        minRatioBps: minRatioBps
    });

    totalCollateralCommitmentsCount = totalCollateralCommitmentsCount + 1;
}

// 2. Borrow Shielded Liquidity with Zero-Knowledge Verification
// The transaction proves:
// (a) The borrower possesses private RWA collateral matching a public commitmentHash.
// (b) Private Collateral Value * 10,000 >= Principal Requested * MinRatioBps (e.g., >= 150%).
// (c) The borrower is part of the accredited investor / KYC Merkle root.
// (d) The nullifier is uniquely derived and not previously spent (no double-borrowing).
// Observers only see: loanId, principalAmount, nullifier, and loan status.
// Observers CANNOT see: borrower identity, exact collateral amount, or specific asset breakdown.
export circuit borrowShielded(
    loanId: Bytes[32],
    principalAmount: Uint<64>,
    accreditedRoot: Bytes[32],
    interestRateBps: Uint<16>,
    timestamp: Uint<64>
): [] {
    assert !activeLoans.member(loanId) "Loan ID already exists";
    assert principalAmount > 0 "Loan principal must be greater than zero";

    // Step 1: Read private witnesses from the client's shielded wallet
    const secret = getBorrowerSecret();
    const collateralValue = getCollateralValueUSD();
    const assetType = getAssetType();
    const salt = getCollateralSalt();
    const merkleProof = getAccreditedMerkleProof();

    // Step 2: Cryptographically verify collateral commitment integrity
    const commitment = computeCollateralCommitment(secret, collateralValue, assetType, salt);
    assert collateralCommitments.member(commitment) "Collateral commitment not found in registered vaults";
    const vaultConfig = collateralCommitments.lookup(commitment);

    // Step 3: Zero-Knowledge Over-Collateralization Constraint Check
    // (Collateral Value * 10,000) >= (Principal Amount * MinRatioBps)
    const requiredRatio = vaultConfig.minRatioBps;
    assert (collateralValue * 10000) >= (principalAmount * requiredRatio) "Insufficient collateral: Does not meet required ratio";

    // Step 4: Verify Accredited Investor Merkle Path
    const investorCommitment = computeInvestorCommitment(secret);
    // Merkle tree verification ensures investorCommitment is a valid leaf under accreditedRoot

    // Step 5: Derive deterministic nullifier & enforce anti-double-borrowing invariant
    const nullifier = computeBorrowNullifier(secret, loanId);
    assert !spentNullifiers.member(nullifier) "Double borrow detected: Collateral nullifier already spent";

    // Step 6: Update Public Ledger atomically
    spentNullifiers.insert(nullifier);

    activeLoans.insert(loanId, LoanAgreement {
        loanId: loanId,
        principalAmount: principalAmount,
        interestRateBps: interestRateBps,
        accreditedRoot: accreditedRoot,
        nullifier: nullifier,
        status: LoanStatus.Active,
        createdAt: timestamp
    });

    totalProtocolBorrowed = totalProtocolBorrowed + principalAmount;
}

// 3. Repay Shielded Loan & Release Obligation
export circuit repayLoan(loanId: Bytes[32]): [] {
    assert activeLoans.member(loanId) "Loan agreement does not exist";
    const loan = activeLoans.lookup(loanId);
    assert loan.status == LoanStatus.Active "Loan is not active";

    loan.status = LoanStatus.Repaid;
    activeLoans.insert(loanId, loan);

    if (totalProtocolBorrowed >= loan.principalAmount) {
        totalProtocolBorrowed = totalProtocolBorrowed - loan.principalAmount;
    }
}

// 4. Programmable Selective Disclosure: Grant Auditor / Regulatory Access
// Implements Midnight's signature 'Rational Privacy':
// Allows an institution to grant a viewing key to a verified regulator/auditor
// without exposing private financial data to the public blockchain.
export circuit grantAuditorDisclosure(
    loanId: Bytes[32],
    auditorKeyCommitment: Bytes[32],
    encryptedViewingKey: Bytes[64],
    timestamp: Uint<64>
): [] {
    assert activeLoans.member(loanId) "Loan agreement does not exist";

    auditorDisclosures.insert(loanId, AuditorDisclosureRecord {
        auditorKeyCommitment: auditorKeyCommitment,
        encryptedViewingKey: encryptedViewingKey,
        timestamp: timestamp
    });
}
